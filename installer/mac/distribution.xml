<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>KITNAP</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
        <line choice="models"/>
    </choices-outline>

    <choice id="vst3" title="VST3 plugin" description="For FL Studio, Ableton Live, Cubase, Studio One, Reaper and other VST3 hosts.">
        <pkg-ref id="com.kitnapaudio.kitnap.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit" description="For Logic Pro and GarageBand.">
        <pkg-ref id="com.kitnapaudio.kitnap.au"/>
    </choice>
    <choice id="app" title="Standalone app" description="Use KITNAP without a DAW.">
        <pkg-ref id="com.kitnapaudio.kitnap.app"/>
    </choice>
    <choice id="models" title="AI models" description="Pulls the drums out of a song and splits them into kick, snare, toms, hi-hat and cymbals (650 MB). KITNAP needs them to make a kit.">
        <pkg-ref id="com.kitnapaudio.kitnap.models"/>
    </choice>

    <pkg-ref id="com.kitnapaudio.kitnap.vst3" version="@VERSION@">vst3.pkg</pkg-ref>
    <pkg-ref id="com.kitnapaudio.kitnap.au" version="@VERSION@">au.pkg</pkg-ref>
    <pkg-ref id="com.kitnapaudio.kitnap.app" version="@VERSION@">app.pkg</pkg-ref>
    <pkg-ref id="com.kitnapaudio.kitnap.models" version="@VERSION@">models.pkg</pkg-ref>
</installer-gui-script>
